# Local development example only. Generate a different long value for each
# deployed environment and never commit the real .env file.
DJANGO_SECRET_KEY=replace-with-a-long-random-development-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# This value is used only when DJANGO_DEBUG=false.
DJANGO_SECURE_HSTS_SECONDS=31536000
